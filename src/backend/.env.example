# ─────────────────────────────────────────────────────────────────────────────
# Spottruck — variables de entorno del backend
# Copiá este archivo a `.env` (cp .env.example .env) y completá lo que falte.
# `.env` NUNCA se commitea (está en .gitignore): acá van solo valores de ejemplo.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────────────────────
# Con `docker compose up -d` Postgres queda expuesto en el puerto 5433 del host
# (y Redis en 6380). Si usás un Postgres propio en el 5432, ajustá el puerto.
DATABASE_URL="postgresql://admin:spottruck_dev_pass@127.0.0.1:5433/spottruck?schema=public"
# Redis está configurado pero hoy ningún módulo lo usa (reservado para cache/colas)
REDIS_URL="redis://127.0.0.1:6380"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development            # development | production | test
# Origen del frontend permitido por CORS. Con docker el frontend sale en el 3001;
# con `npm run dev` directo, Vite usa el 3000.
CORS_ORIGIN="http://localhost:3001"

# URLs públicas (links de los emails, back_urls y webhook de MercadoPago).
# En producción usá los dominios reales, ej: https://spottruck.com
FRONTEND_URL="http://localhost:3001"
API_URL="http://localhost:4000"

# ─── Auth ────────────────────────────────────────────────────────────────────
# En desarrollo podés dejarlo vacío (se usa un valor de dev). En PRODUCCIÓN es
# OBLIGATORIO y el servidor no arranca sin él. Generá uno fuerte con:
#   openssl rand -hex 32
JWT_SECRET=""

# ─── MercadoPago (Checkout Pro) ──────────────────────────────────────────────
# Access token de tu aplicación: https://www.mercadopago.com.ar/developers/panel
# Usá las credenciales de PRUEBA (TEST-...) para desarrollo.
# Sin token la app funciona en modo simulado: el pago queda HELD sin cobro real.
MERCADOPAGO_ACCESS_TOKEN=""
# Secret para validar la firma de los webhooks (sección Webhooks del panel).
# En producción es OBLIGATORIO: sin secret el webhook se rechaza.
MERCADOPAGO_WEBHOOK_SECRET=""

# ─── Emails (Resend) ─────────────────────────────────────────────────────────
# API key de https://resend.com — sin key los emails se imprimen en la consola
# del servidor (verificación de cuenta y reset de contraseña incluidos).
RESEND_API_KEY=""
# Remitente verificado en Resend. Para pruebas sirve onboarding@resend.dev
EMAIL_FROM="Spottruck <onboarding@resend.dev>"
